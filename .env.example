# Dedicated Slutbot database — do not use the shared Erogram DB name.
MONGODB_URI=
MONGODB_DB=slutbot
JWT_SECRET=

# Dedicated upload bucket — do not use erogramimages. Preset CDN bucket stays public.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_UPLOAD_BUCKET=slutbotai
R2_PUBLIC_URL=
R2_PRESET_BUCKET=slutbotai
NEXT_PUBLIC_PRESET_MEDIA_BASE=
WAVESPEED_API_KEY=
NEXT_PUBLIC_APP_URL=https://aislutbot.com
ADMIN_USERNAME=
ADMIN_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Telegram Stars — dedicated AI SLUTBOT bot ONLY. Never reuse the Erogram VIP bot token.
# Create the bot in Telegram with @BotFather, then paste the token here and in Vercel.
TELEGRAM_PAYMENT_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# NOWPAYMENTS_API_KEY=
# NOWPAYMENTS_IPN_SECRET=

# Admin sale alerts (web push). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional Telegram DM for sales, using TELEGRAM_PAYMENT_BOT_TOKEN
