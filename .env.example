# Dedicated Slutbot database — do not use the shared Erogram DB name.
MONGODB_URI=
MONGODB_DB=slutbot
JWT_SECRET=

# Dedicated upload bucket — do not use erogramimages. Preset CDN bucket stays public.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_UPLOAD_BUCKET=slutbotai
R2_PUBLIC_URL=
R2_PRESET_BUCKET=slutbotai
NEXT_PUBLIC_PRESET_MEDIA_BASE=
WAVESPEED_API_KEY=
NEXT_PUBLIC_APP_URL=https://aislutbot.com
ADMIN_USERNAME=
ADMIN_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Telegram Stars + Telegram Login — dedicated AI SLUTBOT bot ONLY. Never reuse the Erogram VIP bot token.
# Create the bot in Telegram with @BotFather, then paste the token here and in Vercel.
# For website login, open @BotFather → /setdomain → aislutbot.com (no https, no www).
# Login uses the official Telegram Login Widget (same flow as Erogram).
TELEGRAM_PAYMENT_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# NOWPAYMENTS_API_KEY=
# NOWPAYMENTS_IPN_SECRET=

# Admin sale alerts (web push). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional Telegram DM for sales, using TELEGRAM_PAYMENT_BOT_TOKEN
# ADMIN_TELEGRAM_CHAT_ID=

# Welcome + purchase emails from hello@aislutbot.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=hello@aislutbot.com
SMTP_FROM_NAME=AI SLUTBOT
# Never set this unless you explicitly want signup/purchase mail to go to users.
# EMAIL_SEND_TO_USERS=true
